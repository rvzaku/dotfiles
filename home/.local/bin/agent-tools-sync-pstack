#!/usr/bin/env bash
# Reconcile removed pstack skills and report changes to locally adapted pstack content.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agent-tools"
PORTS_MANIFEST="$CONFIG_DIR/ports.tsv"
[[ -f "$PORTS_MANIFEST" ]] || exit 0

node - "$PORTS_MANIFEST" <<'NODE'
import fs from 'node:fs';
import crypto from 'node:crypto';
import { spawnSync } from 'node:child_process';
const manifest = fs.readFileSync(process.argv[2], 'utf8');
const entries = manifest.split(/\r?\n/).filter(line => line && !line.startsWith('#'));
const digest = data => crypto.createHash('sha256').update(Buffer.from(data)).digest('hex');
let failures = 0;

for (const line of entries) {
  const [skill, commit, path] = line.split('\t');
  const pinnedUrl = `https://raw.githubusercontent.com/cursor/plugins/${commit}/${path}`;
  const latestUrl = `https://raw.githubusercontent.com/cursor/plugins/main/${path}`;
  try {
    const pinned = await fetch(pinnedUrl);
    const latest = await fetch(latestUrl);
    if (!pinned.ok || !latest.ok) throw new Error(`HTTP ${pinned.status}/${latest.status}`);
    if (digest(await pinned.arrayBuffer()) !== digest(await latest.arrayBuffer())) {
      console.warn(`STALE PORT: ${skill} <- ${path} changed upstream since ${commit}; review and re-port`);
    }
  } catch (error) {
    failures++;
    console.warn(`PORT CHECK UNAVAILABLE: ${skill} <- ${path}: ${error.message}`);
  }
}

const lockPath = `${process.env.HOME}/.agents/.skill-lock.json`;
if (fs.existsSync(lockPath)) {
  try {
    const lock = JSON.parse(fs.readFileSync(lockPath, 'utf8'));
    const response = await fetch('https://api.github.com/repos/cursor/plugins/git/trees/main?recursive=1');
    if (!response.ok) throw new Error(`GitHub tree returned HTTP ${response.status}`);
    const tree = await response.json();
    const paths = new Set((tree.tree ?? []).map(entry => entry.path));
    const pstackEntries = Object.entries(lock.skills ?? {}).filter(([, entry]) =>
      entry.source === 'cursor/plugins' && entry.ref === 'main' &&
      entry.skillPath?.startsWith('pstack/skills/')
    );
    const candidates = [];
    for (const [name, entry] of pstackEntries) {
      let stale = !paths.has(entry.skillPath);
      if (!stale) {
        const source = await fetch(`https://raw.githubusercontent.com/cursor/plugins/main/${entry.skillPath}`);
        if (!source.ok) throw new Error(`${entry.skillPath} returned HTTP ${source.status}`);
        const frontmatter = (await source.text()).match(/^---\s*\r?\n([\s\S]*?)\r?\n---/);
        const currentName = frontmatter?.[1].match(/^name:\s*["']?(.+?)["']?\s*$/m)?.[1];
        if (currentName && currentName !== name) stale = true;
      }
      if (stale) candidates.push(name);
    }
    for (const name of candidates) {
      console.log(`Removing deleted or renamed pstack skill: ${name}`);
      const result = spawnSync('npx', ['--yes', 'skills', 'remove', name, '--global', '--yes'], {
        stdio: 'inherit',
        env: process.env,
      });
      if (result.status !== 0) {
        failures++;
        console.warn(`Could not remove stale pstack skill: ${name}`);
      }
    }
  } catch (error) {
    failures++;
    console.warn(`PSTACK SKILL RECONCILIATION UNAVAILABLE: ${error.message}`);
  }
}

if (failures) console.warn(`Pstack source check/reconciliation had ${failures} failure(s).`);
if (failures) process.exitCode = 1;
NODE
