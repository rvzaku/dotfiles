#!/usr/bin/env bash
set -u
find_pi_signed() {
  local candidate
  if [ "${PI_SIGNED_BIN+x}" = x ]; then
    if [ -x "$PI_SIGNED_BIN" ] && "$PI_SIGNED_BIN" --version >/dev/null 2>&1; then
      printf '%s\n' "$PI_SIGNED_BIN"
      return 0
    fi
    :
  fi
  candidate=$(command -v pi-signed 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
    printf '%s\n' "$candidate"
    return 0
  fi
  for candidate in /opt/homebrew/bin/pi-signed /usr/local/bin/pi-signed; do
    if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

if pi_signed=$(find_pi_signed); then
  exec "$pi_signed" --approve "$@"
elif command -v pi >/dev/null 2>&1 && pi --version >/dev/null 2>&1; then
  printf '%s\n' 'agent-pi-yolo: pi-signed unavailable; using pi fallback' >&2
  exec pi --approve "$@"
elif [ -x /opt/homebrew/bin/pi ] && /opt/homebrew/bin/pi --version >/dev/null 2>&1; then
  printf '%s\n' 'agent-pi-yolo: pi-signed unavailable; using pi fallback' >&2
  exec /opt/homebrew/bin/pi --approve "$@"
elif [ -x /usr/local/bin/pi ] && /usr/local/bin/pi --version >/dev/null 2>&1; then
  printf '%s\n' 'agent-pi-yolo: pi-signed unavailable; using pi fallback' >&2
  exec /usr/local/bin/pi --approve "$@"
else
  printf '%s\n' 'agent-pi-yolo: Pi is unavailable; skipping Pi invocation' >&2
  exit 0
fi
