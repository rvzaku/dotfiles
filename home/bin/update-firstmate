#!/usr/bin/env bash
# Fetch Kun's Firstmate checkout without rewriting any local work.
set -u

resolve_script_dir() {
  local script_path="${BASH_SOURCE[0]}" link script_dir
  while [ -L "$script_path" ]; do
    script_dir=$(cd "$(dirname "$script_path")" && pwd -P)
    link=$(readlink "$script_path")
    case "$link" in
      /*) script_path=$link ;;
      *) script_path="$script_dir/$link" ;;
    esac
  done
  cd "$(dirname "$script_path")" && pwd -P
}

script_dir=$(resolve_script_dir)
dotfiles_root=${DOTFILES_ROOT:-$(cd "$script_dir/../.." && pwd -P)}
backup_base="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/backups/firstmate"

backup_existing() {
  local target=$1 candidate stamp counter=0 destination
  BACKUP_PATH=
  [ -e "$target" ] || [ -L "$target" ] || return 0
  stamp=$(date -u '+%Y%m%dT%H%M%SZ')
  mkdir -p "$backup_base" || return 1
  while :; do
    candidate="$backup_base/$stamp-$$"
    [ "$counter" -eq 0 ] || candidate="$candidate-$counter"
    if mkdir "$candidate" 2>/dev/null; then
      destination="$candidate/$(basename "$target")"
      if mv "$target" "$destination"; then
        BACKUP_PATH=$destination
        printf 'firstmate: backed up %s to %s\n' "$target" "$destination"
        return 0
      fi
      rmdir "$candidate" 2>/dev/null || true
      return 1
    fi
    counter=$((counter + 1))
  done
}

resolve_pi_signed() {
  local candidate
  if [ "${PI_SIGNED_BIN+x}" = x ]; then
    if [ -x "$PI_SIGNED_BIN" ] && "$PI_SIGNED_BIN" --version >/dev/null 2>&1; then
      printf '%s\n' 'pi-signed'
      return 0
    fi
  fi
  if candidate=$(command -v pi-signed 2>/dev/null) && [ -x "$candidate" ] \
    && "$candidate" --version >/dev/null 2>&1; then
    printf '%s\n' 'pi-signed'
    return 0
  fi
  for candidate in /opt/homebrew/bin/pi-signed /usr/local/bin/pi-signed; do
    if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' 'pi-signed'
      return 0
    fi
  done
  if candidate=$(command -v pi 2>/dev/null) && [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
    printf '%s\n' 'pi'
    return 0
  fi
  for candidate in /opt/homebrew/bin/pi /usr/local/bin/pi; do
    if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' 'pi'
      return 0
    fi
  done
  return 1
}

materialize_firstmate_config() {
  local config_dir="$repo/config" dispatch="$dotfiles_root/home/.config/firstmate/crew-dispatch.json"
  local harness transaction_dir config_created=0 target i harness_available=1
  local -a targets staged_paths changed_indices backup_targets backup_paths installed_indices
  changed_indices=()
  backup_targets=()
  backup_paths=()
  installed_indices=()
  [ -f "$dispatch" ] || {
    printf 'firstmate: missing authored crew-dispatch.json at %s\n' "$dispatch" >&2
    return 1
  }
  local jq_bin
  jq_bin=$(command -v jq 2>/dev/null || true)
  [ -n "$jq_bin" ] || {
    printf '%s\n' 'firstmate: jq is required to validate crew-dispatch.json' >&2
    return 1
  }
  "$jq_bin" -e 'type == "object"' "$dispatch" >/dev/null 2>&1 || {
    printf 'firstmate: authored crew-dispatch.json is invalid: %s\n' "$dispatch" >&2
    return 1
  }
  if [ -L "$config_dir" ] || { [ -e "$config_dir" ] && [ ! -d "$config_dir" ]; }; then
    printf 'firstmate: refusing unexpected config path %s\n' "$config_dir" >&2
    return 1
  fi
  if [ -d "$config_dir" ]; then
    :
  else
    mkdir -p "$config_dir" && chmod 700 "$config_dir" || return 1
    config_created=1
  fi
  if ! harness=$(resolve_pi_signed); then
    harness=''
    harness_available=0
    printf '%s\n' 'firstmate: pi-signed and pi are unavailable; preserving crew-harness and continuing other config materialization' >&2
  fi
  transaction_dir=$(mktemp -d "$config_dir/.firstmate-transaction.XXXXXX") || {
    [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true
    return 1
  }
  targets=(
    "$config_dir/crew-dispatch.json"
    "$config_dir/backend"
    "$config_dir/crew-harness"
    "$config_dir/backlog-backend"
  )
  staged_paths=(
    "$transaction_dir/crew-dispatch.json"
    "$transaction_dir/backend"
    "$transaction_dir/crew-harness"
    "$transaction_dir/backlog-backend"
  )
  cp -p "$dispatch" "${staged_paths[0]}" || { rm -rf "$transaction_dir"; [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true; return 1; }
  printf '%s\n' 'herdr' >"${staged_paths[1]}" || { rm -rf "$transaction_dir"; [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true; return 1; }
  if [ "$harness_available" -eq 1 ]; then
    printf '%s\n' "$harness" >"${staged_paths[2]}" || { rm -rf "$transaction_dir"; [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true; return 1; }
  fi
  printf '%s\n' 'tasks-axi' >"${staged_paths[3]}" || { rm -rf "$transaction_dir"; [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true; return 1; }
  chmod 600 "${staged_paths[1]}" "${staged_paths[3]}" || { rm -rf "$transaction_dir"; [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true; return 1; }
  if [ "$harness_available" -eq 1 ]; then
    chmod 600 "${staged_paths[2]}" || { rm -rf "$transaction_dir"; [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true; return 1; }
  fi

  for i in "${!targets[@]}"; do
    target=${targets[$i]}
    if [ "$i" -eq 2 ] && [ "$harness_available" -eq 0 ]; then
      continue
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
      if [ -d "$target" ] && [ ! -L "$target" ]; then
        printf 'firstmate: refusing to replace directory %s\n' "$target" >&2
        rm -rf "$transaction_dir"
        [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true
        return 1
      fi
      if [ -f "$target" ] && [ ! -L "$target" ] && cmp -s "${staged_paths[$i]}" "$target"; then
        continue
      fi
    fi
    changed_indices+=("$i")
  done

  rollback_materialization() {
    local j index
    for ((j=${#installed_indices[@]} - 1; j >= 0; j--)); do
      index=${installed_indices[$j]}
      rm -f "${targets[$index]}"
    done
    for ((j=${#backup_targets[@]} - 1; j >= 0; j--)); do
      if [ -e "${backup_paths[$j]}" ] || [ -L "${backup_paths[$j]}" ]; then
        mv -f "${backup_paths[$j]}" "${backup_targets[$j]}" || true
      fi
    done
    rm -rf "$transaction_dir"
    [ "$config_created" -eq 0 ] || rmdir "$config_dir" 2>/dev/null || true
  }

  if ((${#changed_indices[@]} > 0)); then
    for i in "${changed_indices[@]}"; do
      target=${targets[$i]}
      if [ -e "$target" ] || [ -L "$target" ]; then
        backup_existing "$target" || { rollback_materialization; return 1; }
        backup_targets+=("$target")
        backup_paths+=("$BACKUP_PATH")
      fi
    done
  fi
  if ((${#changed_indices[@]} > 0)); then
    for i in "${changed_indices[@]}"; do
      if ! mv -f "${staged_paths[$i]}" "${targets[$i]}"; then
        rollback_materialization
        return 1
      fi
      installed_indices+=("$i")
    done
  fi
  rm -rf "$transaction_dir"
  if [ "$harness_available" -eq 1 ]; then
    printf 'firstmate: materialized backend=herdr crew-harness=%s backlog-backend=tasks-axi\n' "$harness"
  else
    printf '%s\n' 'firstmate: materialized backend=herdr backlog-backend=tasks-axi; crew-harness remains unchanged because no healthy Pi executable is available'
  fi
}

repo="${FIRSTMATE_HOME:-$HOME/firstmate}"
if [ ! -e "$repo/.git" ]; then
  printf 'firstmate: %s is not installed; update is unproven\n' "$repo" >&2
  exit 1
fi
case "${1:-}" in
  --materialize-config)
    materialize_firstmate_config
    exit $?
    ;;
  '') ;;
  *) printf 'usage: %s [--materialize-config]\n' "$0" >&2; exit 2 ;;
esac
materialize_firstmate_config || exit 1
branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD || true)

# Fetch directly from Kun even if a user changed the checkout's origin to a
# fork. The dedicated remote-tracking ref does not rewrite remotes or work.
upstream_url="https://github.com/kunchenguid/firstmate.git"
upstream_ref="refs/remotes/dotfiles-kun/$branch"
if [ -n "$branch" ]; then
  fetch_refspec="+refs/heads/$branch:$upstream_ref"
else
  fetch_refspec='+refs/heads/*:refs/remotes/dotfiles-kun/*'
fi
if ! git -C "$repo" fetch --prune "$upstream_url" "$fetch_refspec"; then
  printf '%s\n' 'firstmate: Kun upstream fetch failed; preserving the current checkout' >&2
  exit 1
fi
if [ -z "$branch" ]; then
  printf '%s\n' 'firstmate: detached HEAD; fetched Kun refs and preserved checkout'
  exit 0
fi
if ! git -C "$repo" show-ref --verify --quiet "$upstream_ref"; then
  printf 'firstmate: Kun upstream branch %s is unavailable; refusing to update\n' "$branch" >&2
  exit 1
fi
if [ -n "$(git -C "$repo" status --porcelain -- . \
    ':!config/crew-dispatch.json' ':!config/backend' ':!config/crew-harness' \
    ':!config/backlog-backend')" ]; then
  printf '%s\n' 'firstmate: local edits present; refusing to update'
  exit 0
fi

# Check each relation explicitly. In particular, an ahead checkout must not
# receive a merge attempt that could rewrite or obscure the operator's work.
if git -C "$repo" diff --quiet HEAD "$upstream_ref"; then
  printf '%s\n' 'firstmate: already current'
elif git -C "$repo" merge-base --is-ancestor "$upstream_ref" HEAD; then
  printf 'firstmate: local checkout is ahead of Kun/%s; preserving it\n' "$branch"
elif git -C "$repo" merge-base --is-ancestor HEAD "$upstream_ref"; then
  if git -C "$repo" merge --ff-only "$upstream_ref"; then
    printf 'firstmate: fast-forwarded to %s\n' "$(git -C "$repo" rev-parse --short HEAD)"
  else
    printf '%s\n' 'firstmate: fast-forward failed; preserving the current checkout' >&2
    exit 1
  fi
else
  printf 'firstmate: local history diverges from Kun/%s; preserving it\n' "$branch"
fi
