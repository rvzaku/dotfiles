#!/usr/bin/env bash
# Topgrade's custom full-update transaction for mutable agent tooling.
# Targeted Topgrade invocations do not select this custom command; invoking it
# directly with no arguments means the complete transaction.
set -u

resolve_script_dir() {
  local script_path="${BASH_SOURCE[0]}" link script_dir
  while [ -L "$script_path" ]; do
    script_dir=$(cd "$(dirname "$script_path")" && pwd -P)
    link=$(readlink "$script_path")
    case "$link" in
      /*) script_path=$link ;;
      *) script_path="$script_dir/$link" ;;
    esac
  done
  cd "$(dirname "$script_path")" && pwd -P
}

script_dir=$(resolve_script_dir)

if [ "$#" -gt 0 ]; then
  case "$1" in
    -h|--help)
      printf '%s\n' 'usage: update-agent-tools'
      printf '%s\n' 'Runs the complete mutable agent update transaction. Topgrade --only remains targeted.'
      exit 0
      ;;
    *)
      printf 'update-agent-tools: unexpected argument %s; use no arguments for the full transaction\n' "$1" >&2
      exit 2
      ;;
  esac
fi

npm_prefix="${NPM_CONFIG_PREFIX:-$HOME/.local}"
case "$npm_prefix" in
  \$HOME/*) npm_prefix="$HOME/${npm_prefix#\$HOME/}" ;;
esac
case "$npm_prefix" in
  /nix/store/*)
    printf 'agent tools: ignoring read-only Nix npm prefix %s\n' "$npm_prefix" >&2
    npm_prefix="$HOME/.local"
    ;;
esac
export PATH="$npm_prefix/bin:$HOME/firstmate/bin:$PATH"
failures=()

if command -v npm >/dev/null 2>&1; then
  if ! NPM_CONFIG_PREFIX="$npm_prefix" npm install --global --no-fund --no-audit \
    acpx@latest gh-axi@latest chrome-devtools-axi@latest tasks-axi@latest \
    quota-axi@latest lavish-axi@latest backpass@latest skills@latest remote-pi@latest; then
    failures+=(npm)
    printf '%s\n' 'agent tools: npm update failed; continuing with independent updates' >&2
  fi
else
  printf '%s\n' 'agent tools: npm unavailable; global npm updates are unproven' >&2
  failures+=(npm)
fi

if command -v no-mistakes >/dev/null 2>&1; then
  if ! no-mistakes update; then
    failures+=(no-mistakes)
    printf '%s\n' 'agent tools: no-mistakes update failed; continuing' >&2
  fi
else
  printf '%s\n' 'agent tools: no-mistakes unavailable; update is unproven' >&2
  failures+=(no-mistakes)
fi
if command -v treehouse >/dev/null 2>&1; then
  if ! treehouse update; then
    failures+=(treehouse)
    printf '%s\n' 'agent tools: treehouse update failed; continuing' >&2
  fi
else
  printf '%s\n' 'agent tools: treehouse unavailable; update is unproven' >&2
  failures+=(treehouse)
fi

if [ -x "$script_dir/update-skills" ]; then
  if ! "$script_dir/update-skills"; then
    failures+=(skills)
  fi
elif command -v update-skills >/dev/null 2>&1; then
  if ! update-skills; then
    failures+=(skills)
  fi
else
  printf '%s\n' 'skills: updater unavailable; global skill update is unproven' >&2
  failures+=(skills)
fi

# Firstmate is fetched on every full transaction, but update-firstmate refuses
# dirty, ahead, detached, and diverged checkouts without rewriting them.
if command -v update-firstmate >/dev/null 2>&1; then
  if ! update-firstmate; then
    failures+=(firstmate)
  fi
elif [ -x "$script_dir/update-firstmate" ]; then
  if ! "$script_dir/update-firstmate"; then
    failures+=(firstmate)
  fi
else
  printf '%s\n' 'firstmate: updater unavailable; update is unproven' >&2
  failures+=(firstmate)
fi

if ((${#failures[@]} == 0)); then
  if [ -x "$script_dir/prune-migration-backups" ]; then
    if ! "$script_dir/prune-migration-backups"; then failures+=(backup-prune); fi
  elif command -v prune-migration-backups >/dev/null 2>&1; then
    if ! prune-migration-backups; then failures+=(backup-prune); fi
  else
    printf '%s\n' 'backups: pruning helper unavailable; old migration backups retained' >&2
    failures+=(backup-prune)
  fi
else
  printf 'agent tools: retaining migration backups because transaction had failures: %s\n' "${failures[*]}" >&2
fi

if ((${#failures[@]} > 0)); then
  printf 'agent tools: complete update degraded or failed: %s\n' "${failures[*]}" >&2
  exit 1
fi
printf '%s\n' 'agent tools: complete update transaction finished'
