#!/usr/bin/env bash
# Topgrade's custom full-update transaction for mutable agent tooling.
# Targeted Topgrade invocations do not select this custom command; invoking it
# directly with no arguments means the complete transaction.
set -u

resolve_script_dir() {
  local script_path="${BASH_SOURCE[0]}" link script_dir
  while [ -L "$script_path" ]; do
    script_dir=$(cd "$(dirname "$script_path")" && pwd -P)
    link=$(readlink "$script_path")
    case "$link" in
      /*) script_path=$link ;;
      *) script_path="$script_dir/$link" ;;
    esac
  done
  cd "$(dirname "$script_path")" && pwd -P
}

script_dir=$(resolve_script_dir)
resolve_dotfiles_root() {
  local candidate
  if [ -n "${DOTFILES_ROOT:-}" ] && candidate=$(git -C "$DOTFILES_ROOT" rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' "$candidate"
    return 0
  fi
  if candidate=$(git rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' "$candidate"
    return 0
  fi
  if candidate=$(git -C "$HOME/dotfiles" rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' "$candidate"
    return 0
  fi
  if candidate=$(git -C "$script_dir/../.." rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' "$candidate"
    return 0
  fi
  return 1
}
dotfiles_root=$(resolve_dotfiles_root 2>/dev/null || true)
fetch_kun_dotfiles() {
  [ "${DOTFILES_FULL_UPDATE:-}" = 1 ] || return 0
  if [ -z "$dotfiles_root" ]; then
    printf '%s\n' 'dotfiles: cannot resolve checkout root for Kun upstream fetch' >&2
    return 1
  fi
  local fetch_refspec='+refs/heads/*:refs/remotes/dotfiles-kun/*'
  if git -C "$dotfiles_root" fetch --prune https://github.com/kunchenguid/dotfiles.git "$fetch_refspec"; then
    printf '%s\n' 'dotfiles: fetched Kun upstream without merging or rewriting local work'
    return 0
  fi
  printf '%s\n' 'dotfiles: Kun upstream fetch failed; preserving local work' >&2
  return 1
}

if [ "$#" -gt 0 ]; then
  case "$1" in
    -h|--help)
      printf '%s\n' 'usage: update-agent-tools'
      printf '%s\n' 'Runs the complete mutable agent update transaction. Topgrade --only remains targeted.'
      exit 0
      ;;
    *)
      printf 'update-agent-tools: unexpected argument %s; use no arguments for the full transaction\n' "$1" >&2
      exit 2
      ;;
  esac
fi

npm_prefix="${NPM_CONFIG_PREFIX:-$HOME/.local/npm}"
case "$npm_prefix" in
  \$HOME/*) npm_prefix="$HOME/${npm_prefix#\$HOME/}" ;;
esac
case "$npm_prefix" in
  /nix/store/*)
    printf 'agent tools: ignoring read-only Nix npm prefix %s\n' "$npm_prefix" >&2
    npm_prefix="$HOME/.local/npm"
    ;;
esac
extra_path="${DOTFILES_EXTRA_PATH:-}"
trusted_path="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin"
if [ -n "$extra_path" ]; then
  # Explicit fixture/operator override; normal activation keeps trusted bins first.
  export PATH="$extra_path:$trusted_path:$npm_prefix/bin:$HOME/firstmate/bin:$HOME/.local/bin:$HOME/.local/share/pnpm/bin:${PATH:-}"
else
  export PATH="$trusted_path:$npm_prefix/bin:$HOME/firstmate/bin:$HOME/.local/bin:$HOME/.local/share/pnpm/bin:${PATH:-}"
fi
failures=()
verify_av_state() {
  local doctor scan issues blocking
  if ! command -v av >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    printf '%s\n' 'agent tools: Automic Vault and jq are required for full-update verification' >&2
    return 1
  fi
  doctor=$(mktemp "${TMPDIR:-/tmp}/update-agent-av-doctor.XXXXXX") || return 1
  if ! av doctor --json >"$doctor" 2>/dev/null \
    || ! jq -e '(.results | type) == "array" and all(.results[]; (.issues | type) == "array")' "$doctor" >/dev/null 2>&1; then
    rm -f "$doctor"
    printf '%s\n' 'agent tools: Automic Vault doctor verification failed or was malformed' >&2
    return 1
  fi
  issues=$(jq '[.results[].issues[]] | length' "$doctor")
  rm -f "$doctor"
  [ "$issues" -eq 0 ] || {
    printf 'agent tools: Automic Vault doctor reports %s unresolved issue(s)\n' "$issues" >&2
    return 1
  }
  scan=$(mktemp "${TMPDIR:-/tmp}/update-agent-av-scan.XXXXXX") || return 1
  if ! av scan --json >"$scan" 2>/dev/null \
    || ! jq -e '(.findings | type) == "array" and all(.findings[]; (.severity | type) == "string")' "$scan" >/dev/null 2>&1; then
    rm -f "$scan"
    printf '%s\n' 'agent tools: Automic Vault scan verification failed or was malformed' >&2
    return 1
  fi
  blocking=$(jq '[.findings[] | select((.severity | ascii_downcase) == "high" or (.severity | ascii_downcase) == "critical")] | length' "$scan")
  rm -f "$scan"
  [ "$blocking" -eq 0 ] || {
    printf 'agent tools: Automic Vault scan reports %s unresolved HIGH/CRITICAL finding(s)\n' "$blocking" >&2
    return 1
  }
  return 0
}
resolve_pi_runtime() {
  local candidate
  if [ "${PI_SIGNED_BIN+x}" = x ] && [ -n "$PI_SIGNED_BIN" ] \
    && [ -x "$PI_SIGNED_BIN" ] && "$PI_SIGNED_BIN" --version >/dev/null 2>&1; then
    printf '%s\n' "$PI_SIGNED_BIN"
    return 0
  fi
  candidate=$(command -v pi-signed 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
    printf '%s\n' "$candidate"
    return 0
  fi
  for candidate in /opt/homebrew/bin/pi-signed /usr/local/bin/pi-signed; do
    if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  candidate=$(command -v pi 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
    printf '%s\n' "$candidate"
    return 0
  fi
  for candidate in /opt/homebrew/bin/pi /usr/local/bin/pi; do
    if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

update_pi_packages() {
  local pi_bin
  pi_bin=$(resolve_pi_runtime 2>/dev/null || true)
  if [ -z "$pi_bin" ]; then
    printf '%s\n' 'Pi unavailable; skipping native Pi package/catalog update (degraded)' >&2
    return 0
  fi
  if ! "$pi_bin" update; then
    printf '%s\n' 'Pi native package/catalog update failed' >&2
    failures+=(pi)
  fi
}
update_pi_packages
if ! fetch_kun_dotfiles; then
  failures+=(dotfiles-upstream)
fi

if command -v npm >/dev/null 2>&1; then
  if ! NPM_CONFIG_PREFIX="$npm_prefix" npm install --global --no-fund --no-audit \
    acpx@latest gh-axi@latest chrome-devtools-axi@latest tasks-axi@latest \
    quota-axi@latest lavish-axi@latest backpass@latest skills@latest remote-pi@latest; then
    failures+=(npm)
    printf '%s\n' 'agent tools: npm update failed; continuing with independent updates' >&2
  fi
else
  printf '%s\n' 'agent tools: npm unavailable; global npm updates are unproven' >&2
  failures+=(npm)
fi

if command -v no-mistakes >/dev/null 2>&1; then
  if ! no-mistakes update; then
    failures+=(no-mistakes)
    printf '%s\n' 'agent tools: no-mistakes update failed; continuing' >&2
  fi
else
  printf '%s\n' 'agent tools: no-mistakes unavailable; update is unproven' >&2
  failures+=(no-mistakes)
fi
if command -v treehouse >/dev/null 2>&1; then
  if ! treehouse update; then
    failures+=(treehouse)
    printf '%s\n' 'agent tools: treehouse update failed; continuing' >&2
  fi
else
  printf '%s\n' 'agent tools: treehouse unavailable; update is unproven' >&2
  failures+=(treehouse)
fi

if [ -x "$script_dir/update-skills" ]; then
  if ! "$script_dir/update-skills"; then
    failures+=(skills)
  fi
elif command -v update-skills >/dev/null 2>&1; then
  if ! update-skills; then
    failures+=(skills)
  fi
else
  printf '%s\n' 'skills: updater unavailable; global skill update is unproven' >&2
  failures+=(skills)
fi

# Firstmate is fetched on every full transaction, but update-firstmate refuses
# dirty, ahead, detached, and diverged checkouts without rewriting them.
if command -v update-firstmate >/dev/null 2>&1; then
  if ! DOTFILES_ROOT="$dotfiles_root" FIRSTMATE_HOME="${FIRSTMATE_HOME:-$HOME/firstmate}" update-firstmate; then
    failures+=(firstmate)
  fi
elif [ -x "$script_dir/update-firstmate" ]; then
  if ! DOTFILES_ROOT="$dotfiles_root" FIRSTMATE_HOME="${FIRSTMATE_HOME:-$HOME/firstmate}" "$script_dir/update-firstmate"; then
    failures+=(firstmate)
  fi
else
  printf '%s\n' 'firstmate: updater unavailable; update is unproven' >&2
  failures+=(firstmate)
fi

if ! verify_av_state; then
  failures+=(av-verification)
fi

if ((${#failures[@]} == 0)); then
  if [ -x "$script_dir/prune-migration-backups" ]; then
    if ! "$script_dir/prune-migration-backups"; then failures+=(backup-prune); fi
  elif command -v prune-migration-backups >/dev/null 2>&1; then
    if ! prune-migration-backups; then failures+=(backup-prune); fi
  else
    printf '%s\n' 'backups: pruning helper unavailable; old migration backups retained' >&2
    failures+=(backup-prune)
  fi
else
  printf 'agent tools: retaining migration backups because transaction had failures: %s\n' "${failures[*]}" >&2
fi

if ((${#failures[@]} > 0)); then
  printf 'agent tools: complete update degraded or failed: %s\n' "${failures[*]}" >&2
  exit 1
fi
printf '%s\n' 'agent tools: complete update transaction finished'
