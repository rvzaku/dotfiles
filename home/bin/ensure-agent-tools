#!/usr/bin/env bash
set -u
npm_prefix="${NPM_CONFIG_PREFIX:-$HOME/.local/npm}"
case "$npm_prefix" in
  \$HOME/*) npm_prefix="$HOME/${npm_prefix#\$HOME/}" ;;
esac
case "$npm_prefix" in
  /nix/store/*)
    printf 'agent tools: ignoring read-only Nix npm prefix %s\n' "$npm_prefix" >&2
    npm_prefix="$HOME/.local/npm"
    ;;
esac
extra_path="${DOTFILES_EXTRA_PATH:-}"
trusted_path="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin"
if [ -n "$extra_path" ]; then
  # Explicit fixture/operator override; normal activation keeps trusted bins first.
  export PATH="$extra_path:$trusted_path:$npm_prefix/bin:$HOME/firstmate/bin:$HOME/.local/bin:$HOME/.local/share/pnpm/bin:${PATH:-}"
else
  export PATH="$trusted_path:$npm_prefix/bin:$HOME/firstmate/bin:$HOME/.local/bin:$HOME/.local/share/pnpm/bin:${PATH:-}"
fi

usage() {
  printf 'usage: %s [--install]\n' "$0"
  printf '%s\n' 'Checks pinned global npm tools and official no-mistakes/treehouse installers.'
}
install_missing=false
case "${1:-}" in
  '') ;;
  --install) install_missing=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

missing=()
for tool in node npm gh gh-axi acpx chrome-devtools-axi tasks-axi quota-axi lavish-axi backpass skills remote-pi; do
  command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
for tool in no-mistakes treehouse; do
  command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
# Pi is deliberately an optional runtime. Prefer the signed launcher, then the
# plain CLI; neither absence nor a broken Pi install blocks other bootstrap work.
if command -v pi-signed >/dev/null 2>&1; then
  printf '%s\n' 'agent tools: pi-signed is available (preferred)'
elif command -v pi >/dev/null 2>&1; then
  printf '%s\n' 'agent tools: pi-signed unavailable; pi fallback is available' >&2
else
  printf '%s\n' 'agent tools: Pi unavailable; Pi workflows are degraded but bootstrap may continue' >&2
fi

if ((${#missing[@]} == 0)); then
  printf '%s\n' 'agent tools: all required tools are available'
  exit 0
fi
printf 'agent tools: missing %s\n' "${missing[*]}"
if [ "$install_missing" != true ]; then
  printf '%s\n' 'agent tools: rerun with --install to use official installers for no-mistakes/treehouse' >&2
  exit 1
fi

if command -v npm >/dev/null 2>&1; then
  if ! NPM_CONFIG_PREFIX="$npm_prefix" npm install --global --no-fund --no-audit \
    acpx@0.15.1 gh-axi@0.1.35 chrome-devtools-axi@0.1.34 \
    tasks-axi@0.2.5 quota-axi@0.1.44 lavish-axi@0.1.68 \
    backpass@0.1.22 skills@1.5.26 remote-pi@0.7.0; then
    printf '%s\n' 'agent tools: pinned npm installation failed; continuing with official installers' >&2
  fi
else
  printf '%s\n' 'agent tools: npm unavailable; pinned npm tools are degraded' >&2
fi

# These projects publish release checksums. Download the pinned Apple Silicon
# artifacts, verify both checksum manifests and artifacts, then install into a
# user-owned directory; never curl-pipe-to-shell or run an unverified binary.
install_verified_release() {
  local tool=$1 version=$2 artifact=$3 artifact_sha=$4 sums_sha=$5
  local base="https://github.com/kunchenguid/$tool/releases/download/$version"
  local tmp sums archive extracted
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/$tool-install.XXXXXX") || return 1
  sums="$tmp/checksums.txt"
  archive="$tmp/$artifact"
  if ! curl --proto '=https' --tlsv1.2 -fsSL "$base/checksums.txt" -o "$sums" \
    || ! printf '%s  %s\n' "$sums_sha" "$sums" | shasum -a 256 -c - \
    || ! curl --proto '=https' --tlsv1.2 -fsSL "$base/$artifact" -o "$archive" \
    || ! (cd "$tmp" && printf '%s  %s\n' "$artifact_sha" "$artifact" | shasum -a 256 -c -); then
    rm -rf "$tmp"
    return 1
  fi
  tar xzf "$archive" -C "$tmp"
  extracted="$tmp/$tool"
  [ -f "$extracted" ] || { rm -rf "$tmp"; return 1; }
  mkdir -p "$HOME/.local/bin"
  install -m 755 "$extracted" "$HOME/.local/bin/$tool"
  rm -rf "$tmp"
}

if [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ]; then
  if ! command -v no-mistakes >/dev/null 2>&1; then
    install_verified_release no-mistakes v1.75.2 \
      no-mistakes-v1.75.2-darwin-arm64.tar.gz \
      d4388422e773f7ef5e9c87afb35c1e3be0d572c8c8940f54fe6238e88366f2d3 \
      1bfc9b882b4edc1c4c0ecc412102411be8ef50cedae6d3f429b80297ece755a6 \
      || printf '%s\n' 'agent tools: verified no-mistakes release installation failed' >&2
  fi
  if ! command -v treehouse >/dev/null 2>&1; then
    install_verified_release treehouse v2.3.0 \
      treehouse-v2.3.0-darwin-arm64.tar.gz \
      1cb09bcfa830b4eec5e54beeaa71589adb9c5d828573dda0f5150e2d80cf13d \
      c5daa7b483753fd3bcfdf8b0a876474e597ba1857eacf6b59b62671a8b26e542 \
      || printf '%s\n' 'agent tools: verified treehouse release installation failed' >&2
  fi
else
  printf '%s\n' 'agent tools: verified no-mistakes/treehouse releases are pinned for Apple Silicon macOS only' >&2
fi

# Recheck the required set. Pi remains outside this gate by design.
missing_after=()
for tool in node npm gh gh-axi acpx chrome-devtools-axi tasks-axi quota-axi lavish-axi backpass skills remote-pi no-mistakes treehouse; do
  command -v "$tool" >/dev/null 2>&1 || missing_after+=("$tool")
done
if ((${#missing_after[@]} > 0)); then
  printf 'agent tools: still missing %s\n' "${missing_after[*]}" >&2
  exit 1
fi
printf '%s\n' 'agent tools: required tools are available; Pi status is reported separately'
