#!/usr/bin/env bash
set -euo pipefail
export PATH="${NPM_CONFIG_PREFIX:-$HOME/.local}/bin:$PATH"

usage() {
  printf 'usage: %s [--install]\n' "$0"
  printf 'Checks the pinned global npm tools and the no-mistakes/treehouse installers.\n'
}
install_missing=false
case "${1:-}" in
  "") ;;
  --install) install_missing=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

missing=()
for tool in node npm gh gh-axi acpx chrome-devtools-axi tasks-axi quota-axi lavish-axi backpass remote-pi; do
  command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
for tool in no-mistakes treehouse; do
  command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if ((${#missing[@]} == 0)); then
  printf 'agent tools: all required tools are available\n'
  exit 0
fi
printf 'agent tools: missing %s\n' "${missing[*]}"
if [ "$install_missing" != true ]; then
  printf 'agent tools: rerun with --install to use the official installers for no-mistakes/treehouse\n' >&2
  exit 1
fi

# npm tools are declaratively installed by Home Manager. This command only
# repairs a not-yet-run activation and never changes versions implicitly.
if command -v npm >/dev/null 2>&1; then
  NPM_CONFIG_PREFIX="${NPM_CONFIG_PREFIX:-$HOME/.local}" npm install --global --no-fund --no-audit \
    acpx@0.15.1 \
    gh-axi@0.1.35 \
    chrome-devtools-axi@0.1.34 \
    tasks-axi@0.2.5 \
    quota-axi@0.1.44 \
    lavish-axi@0.1.68 \
    backpass@0.1.22 \
    remote-pi@0.7.0
fi

# These projects publish signed/verified installers and are intentionally not
# replaced by an unpinned npm or Homebrew package.
if ! command -v no-mistakes >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -fsSL https://raw.githubusercontent.com/kunchenguid/no-mistakes/main/docs/install.sh | sh
fi
if ! command -v treehouse >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -fsSL https://kunchenguid.github.io/treehouse/install.sh | sh
fi

exec "$0"
