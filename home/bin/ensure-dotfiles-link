#!/usr/bin/env bash
# Safely establish the conventional $HOME/dotfiles path when an operator has
# intentionally chosen a clone elsewhere. Bootstrap does not call this helper:
# it passes DOTFILES_ROOT directly so arbitrary clone paths remain portable.
set -euo pipefail

usage() { printf 'usage: %s SOURCE_REPOSITORY DOTFILES_PATH\n' "$0" >&2; }
[ "$#" -eq 2 ] || { usage; exit 2; }
source_dir=$(cd "$1" && pwd -P)
link_path=$2

if [ -L "$link_path" ] || [ -d "$link_path" ]; then
  current_dir=$(cd "$link_path" 2>/dev/null && pwd -P || true)
  if [ "$current_dir" = "$source_dir" ]; then
    printf 'dotfiles: %s already points to %s\n' "$link_path" "$source_dir"
    exit 0
  fi
  printf 'dotfiles: refusing to replace existing path %s\n' "$link_path" >&2
  printf 'dotfiles: it resolves to %s; move it aside yourself if intentional\n' "${current_dir:-an unavailable target}" >&2
  exit 1
fi
if [ -e "$link_path" ]; then
  printf 'dotfiles: refusing to replace existing non-directory path %s\n' "$link_path" >&2
  exit 1
fi
ln -s "$source_dir" "$link_path"
printf 'dotfiles: linked %s to %s\n' "$link_path" "$source_dir"
