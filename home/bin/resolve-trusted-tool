#!/usr/bin/env bash
set -u

tool=${1:-}
case "$tool" in
  av|jq) ;;
  *) exit 2 ;;
esac

user_profile=''
if [ -n "${USER:-}" ]; then
  user_profile="/etc/profiles/per-user/$USER/bin"
elif [ -x /usr/bin/id ]; then
  user_profile="/etc/profiles/per-user/$(/usr/bin/id -un 2>/dev/null)/bin"
fi
for directory in \
  /usr/bin /bin /usr/sbin /sbin \
  /opt/homebrew/bin /opt/homebrew/sbin \
  /run/current-system/sw/bin /nix/var/nix/profiles/default/bin \
  "$user_profile" /usr/local/bin; do
  [ -n "$directory" ] || continue
  candidate="$directory/$tool"
  if [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    exit 0
  fi
done
exit 1
