# Herdr runtime artifacts (regenerated at runtime; never commit). The authored
# config is the only tracked leaf in this directory.
home/.config/herdr/*
!home/.config/herdr/config.toml

# macOS + nix build noise
.DS_Store
result
result-*

# Pi credentials and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/

# Backpass project/user evidence and runtime state (never commit)
.backpass/
home/.config/backpass/user/
home/.config/backpass/*.log

# Firstmate runtime state is external to the authored dispatch profile
home/.config/firstmate/state/

# Pi package downloads, trust, credentials, sessions, and remote-pi state
home/.pi/agent/npm/
home/.pi/agent/trust.json
home/.pi/agent/sessions/
home/.pi/remote/

# Home Manager generates this target from programs.topgrade.settings; a stale
# checkout copy must never be mistaken for authored Topgrade configuration.
home/.config/topgrade.toml
